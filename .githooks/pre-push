#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════════
# 푸시 게이트(260802) — **리베이스로 뒤바뀐 상태**를 push 직전에 잡는다.
#
# 왜 pre-commit만으로는 안 되나(실측 260802 사고):
#   커밋 시점엔 게이트가 통과했는데, `git rebase origin/main`의 **자동병합**이 남의 커밋과
#   내 커밋을 섞으면서 thumb 빈 캡슐 술어 한 줄이 구판으로 되돌아간 채 main에 들어갔다.
#   커밋 → 리베이스 → 푸시 순서에서 **리베이스 뒤에는 아무 게이트도 없었다**는 게 원인.
#   이 레포는 봇·병렬 세션 커밋이 초당급으로 main에 들어와 [7-5] 재시도 리베이스가 상시라
#   「커밋 때 통과 → 푸시 때 깨짐」이 구조적으로 재발한다 → 실효 방어선 = pre-push.
#
# 셋업(기기·clone마다 1회): git config core.hooksPath .githooks   ← pre-commit과 공용
# 의도적 우회(비상시만): git push --no-verify
#
# CI 러너 제외(pre-commit 260728 선례 동축·이중 방어) — 봇 푸시는 데이터 산출물뿐이라
#   원장·코드 무접촉인데 *사람 세션이 남긴* 위반에 걸려 파이프라인이 죽는 사고를 막는다.
#   CI 축은 check-refs.yml·ledger-gate.yml이 그대로 담당 = 커버리지 손실 0.
# ═══════════════════════════════════════════════════════════════════════════════
[ -n "$GITHUB_ACTIONS" ] && exit 0

ROOT=$(git rev-parse --show-toplevel)
Z=0000000000000000000000000000000000000000
HEAD_SHA=$(git rev-parse HEAD)
CHECK=0
MISMATCH=''

# stdin = "<local ref> <local sha> <remote ref> <remote sha>" 줄들.
# 삭제 푸시(local sha = 0…)는 검사 대상 없음 → 건너뛴다.
while read -r _lref lsha _rref _rsha; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$Z" ] && continue
  CHECK=1
  [ "$lsha" != "$HEAD_SHA" ] && MISMATCH="$MISMATCH $lsha"
done

[ "$CHECK" = 0 ] && exit 0

# ⚠ 정직 신고(한계): 게이트는 **작업 트리(HEAD)** 를 잰다 — 파일을 읽는 게이트라 트리가 필요하고,
#   임시 워크트리 체크아웃은 이 레포 크기(영상 자산)에서 푸시마다 물릴 비용이 아니다.
#   HEAD == 푸시 sha 인 정상 경로(= 사고가 났던 그 경로: rebase 후 `git push origin HEAD:main`)는 정확히 같은 트리다.
#   다르면 아래 경고를 띄우고 그래도 HEAD 기준으로 잰다(= 무검사보다 낫다).
if [ -n "$MISMATCH" ]; then
  echo "⚠️ 푸시 게이트 — 푸시 대상 sha가 HEAD와 다르다($MISMATCH) → 게이트는 HEAD 트리 기준으로 잰다(한계 명시)."
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "⚠️ 푸시 게이트 — 작업 트리에 커밋 안 된 변경이 있다 → 게이트가 재는 건 '지금 파일 상태'지 푸시될 커밋이 아니다."
fi

echo "── 푸시 게이트: check_refs (리베이스 후 드리프트 차단 · 우회 = --no-verify)"
python3 "$ROOT/shared/check_refs.py" || {
  echo "❌ 푸시 중단 — 위 게이트를 고치고 다시 푸시해라(리베이스 자동병합이 정본을 되돌렸을 수 있다: 되돌아간 줄을 복구할 것)."
  exit 1
}
exit 0
