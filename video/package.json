{
  "name": "nomute-video",
  "private": true,
  "type": "module",
  "description": "노뮤트 뉴스 → MP4 (hyperframes · 프리미어/AE 없이 HTML을 그대로 렌더)",
  "scripts": {
    "build": "node build.mjs",
    "doctor": "hyperframes doctor",
    "lint": "hyperframes lint .",
    "preview": "hyperframes preview .",
    "render": "node build.mjs && hyperframes render . --workers 1 -o out/news-card.mp4",
    "render:batch": "node build.mjs && hyperframes render . --workers 1 --batch .build/rows.json -o \"out/{name}.mp4\""
  },
  "dependencies": {
    "hyperframes": "0.7.87"
  }
}
